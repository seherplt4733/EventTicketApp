<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventTicketApp</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventTicketApp.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    🎫 EventTicketApp
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">🏠 Anasayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">🎟️ Etkinlikler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categories" asp-action="Index">📂 Kategoriler</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Create">+ Yeni Etkinlik</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categories" asp-action="Create">+ Kategori</a>
                        </li>

                        <!-- 🌙 Dark Mode Toggle -->
<li class="nav-item ms-2">
    <button id="themeToggle" class="btn btn-outline-light btn-sm" title="Tema Değiştir">
        <span id="themeIcon">🌙</span>
    </button>
</li>
                    </ul>
                    
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 my-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-muted py-3 mt-auto bg-light">
        <div class="container text-center">
            &copy; 2026 - EventTicketApp -
            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Toast Bildirimleri -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // TempData'dan gelen mesajları kontrol et
        var successMsg = '@TempData["Success"]';
        var errorMsg   = '@TempData["Error"]';

        if (successMsg && successMsg.length > 0) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: successMsg,
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
        }

        if (errorMsg && errorMsg.length > 0) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: errorMsg,
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true
            });
        }
    });
</script>



<!-- 🌙 Dark Mode Script -->
<script>
    (function () {
        const htmlEl = document.documentElement;
        const toggleBtn = document.getElementById('themeToggle');
        const iconEl = document.getElementById('themeIcon');
        const savedTheme = localStorage.getItem('theme') || 'light';

        // Sayfa yüklenince tema uygula
        function applyTheme(theme) {
            htmlEl.setAttribute('data-bs-theme', theme);
            if (iconEl) {
                iconEl.textContent = theme === 'dark' ? '☀️' : '🌙';
            }
        }

        applyTheme(savedTheme);

        // Toggle butonuna tıklanınca tema değiştir
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                const current = htmlEl.getAttribute('data-bs-theme') || 'light';
                const next = current === 'dark' ? 'light' : 'dark';
                localStorage.setItem('theme', next);
                applyTheme(next);
            });
        }
    })();
</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>