@model EventTicketApp.Models.Ticket

@{
    ViewData["Title"] = "Bilet Satın Al";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-white border-secondary shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-ticket-perforated"></i> Bilet Satın Al</h4>
                </div>
                <div class="card-body">
                    <h5>@Model.Event?.Title</h5>
                    <p class="text-muted mb-2">
                        <strong>Tarih:</strong> @Model.Event?.EventDate.ToString("dd.MM.yyyy HH:mm") <br />
                        <strong>Konum:</strong> @Model.Event?.Location <br />
                        <strong>Birim Fiyat:</strong> ₺@Model.Event?.Price.ToString("N2")
                    </p>

                    <hr class="border-secondary" />

                    <form asp-action="Buy" method="post">
                        <input type="hidden" asp-for="EventId" />

                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label"></label>
                            <input asp-for="CustomerName" class="form-control bg-dark text-white border-secondary" placeholder="Adınız Soyadınız" />
                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CustomerEmail" class="form-label"></label>
                            <input asp-for="CustomerEmail" type="email" class="form-control bg-dark text-white border-secondary" placeholder="ornek@email.com" />
                            <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label"></label>
                            <input asp-for="Quantity" type="number" min="1" max="@Model.Event?.AvailableSeats" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                            <small class="text-info">Kalan Bilet: @Model.Event?.AvailableSeats</small>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg">Satın Almayı Tamamla</button>
                            <a asp-controller="Events" asp-action="Index" class="btn btn-outline-light">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>